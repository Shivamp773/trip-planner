# Copy this file to `.env` and fill in the values, then restart `npm run dev`.

# Google Gemini API key, used to generate the trip plan.
# Create one at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# GoMaps Pro API key, used for hotel/place photos. Optional: without it the app
# falls back to Wikipedia images and a placeholder. https://map.gomaps.pro
VITE_GOMAPS_API_KEY=

# Google OAuth 2.0 "Web application" client ID, used for "Sign in with Google".
# https://console.cloud.google.com/apis/credentials
# Its "Authorized JavaScript origins" must include http://localhost:5173
VITE_GOOGLE_AUTH_CLIENT_ID=
